# 飞书交易助手的配置模板 (configuration template)
#
# 用法：把这个文件复制一份，改名为 .env，在等号后面填上你自己的值。
# 重要：.env 里有密钥，只放在 VPS 上。不要发到任何聊天里，不要截图，也不要上传到 GitHub。
# 留空的项会使用默认值。

# ---------- 飞书 (Feishu) ----------
# 在飞书开放平台，你的应用的“凭证与基础信息”页面能看到这两项
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 国内版飞书填 feishu，海外版 Lark 填 lark
FEISHU_DOMAIN=feishu
# 你自己的 open_id。机器人跑起来以后，私聊它发送 /whoami 就能拿到
OWNER_OPEN_ID=
# 群的 chat_id。不用手填：把机器人加进群后，你在群里 @机器人 发送“登记本群”，它会自己写进来
GROUP_CHAT_ID=

# ---------- OKX ----------
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
# false 连实盘，true 连模拟盘 (demo trading)。模拟盘要用在模拟盘里单独创建的 key
OKX_DEMO=false
# 一般不用改。只有当你的 OKX 账户不在主站时，才按 OKX 文档给的地址修改
OKX_BASE_URL=https://www.okx.com
# 要盯的品种，多个用英文逗号隔开，第一个是默认品种
WATCH_INSTRUMENTS=XAU-USDT-SWAP

# ---------- Claude ----------
ANTHROPIC_API_KEY=
# 三档模型：给消息分类、平时的问答和简报、“深度”问题和周复盘。一般不用改
MODEL_QUICK=claude-haiku-5-5
MODEL_DAILY=claude-opus-5-5
MODEL_DEEP=claude-opus-5-5
# AI 想得多细 (effort)：low、medium、high、xhigh、max。越高越慢、越贵
# EFFORT_DAILY 管平时的问答和简报，EFFORT_DEEP 管“深度”问题和周复盘
EFFORT_DAILY=medium
EFFORT_DEEP=high
# true：AI 可以联网搜索新闻和经济数据（按次计费）。false：只看 OKX 的行情
WEB_SEARCH=true
# 每月 AI 花费的预算，单位美元，按公开价格估算。到了这个数，机器人自动改用最省的档位。填 off 表示不设上限
AI_MONTHLY_BUDGET_USD=180
# 成绩单 (track record)：把 AI 给出的触发位、目标位、失效位记下来，之后自动对照行情打分。发“成绩单”查看。不多花 AI 的钱
TRACK_RECORD=true
# 每个情景观察多少小时（4 到 72）
TRACK_WINDOW_HOURS=72

# ---------- 时间和定时简报 ----------
# 你所在的时区。洛杉矶是 America/Los_Angeles
TIMEZONE=America/Los_Angeles
# 盘前简报和收盘小结的时间（按上面的时区，24 小时制）。填 off 表示不发
BRIEF_MORNING=06:00
BRIEF_EVENING=14:00
# 每周复盘：星期几加时间，星期用 MON TUE WED THU FRI SAT SUN。填 off 表示不发
WEEKLY_REVIEW=SUN 17:00

# ---------- 监控和提醒 ----------
# 每隔多少秒读一次账户
POLL_SECONDS=30
# 每隔多少分钟记一次账户快照（用来算今日权益变化和周复盘）
SNAPSHOT_MINUTES=15
# 保证金率低于这个值就提醒。3.0 表示 300%（到 100% 开始强平）。填 off 表示不提醒
ALERT_MARGIN_RATIO=3.0
# 标记价离强平价不到百分之几就提醒。填 off 表示不提醒
ALERT_LIQ_DISTANCE_PCT=5.0
# 今天的权益比当天开始时少了多少美元就提醒。留空表示不提醒
ALERT_DAILY_LOSS_USD=
# 同一种提醒至少隔多少分钟才再发一次
ALERT_COOLDOWN_MINUTES=30

# ---------- 群里的规则 ----------
# true：群里和私聊一样，显示资金和盈亏金额，AI 在群里分析时也会看你的账户数据
# false：群里只显示品种、方向和价位
GROUP_SHOW_PNL=true
# true：机器人只响应你本人的指令，群里其他人 @ 它不会得到回答
# false：群里的人也可以 @ 它问行情
GROUP_OWNER_ONLY=true
# 只在 GROUP_OWNER_ONLY=false 时有用：群里除你以外的人，每天一共可以问多少个行情问题
GROUP_DAILY_QUESTION_LIMIT=30

# ---------- 下单 (placing orders)，默认关闭 ----------
# off：机器人只读取账户，不会下单。demo：在 OKX 模拟盘下单。live：在实盘下单
# 打开以后，只有你本人在私聊里发的指令才算数，每条指令都要你回复确认码才执行。发“交易帮助”看写法
# 建议先填 demo，把每种指令试一遍，再考虑 live。这一项和下面的限额只能在这里改，飞书里改不了
TRADING=off
# 模拟盘的三项 key（在 OKX 的“模拟交易”里单独创建）。只有 TRADING=demo 时才用得到
OKX_DEMO_API_KEY=
OKX_DEMO_SECRET_KEY=
OKX_DEMO_PASSPHRASE=
# 允许下单的品种，多个用英文逗号隔开。留空表示和 WATCH_INSTRUMENTS 一样。只支持 USDT 本位永续合约
TRADE_INSTRUMENTS=
# 单笔订单的上限，按名义价值算，单位 USDT
TRADE_MAX_ORDER_USD=1000
# 单个品种的持仓上限（含还没成交的挂单），按名义价值算，单位 USDT
TRADE_MAX_POSITION_USD=3000
# 每天最多开仓几次
TRADE_MAX_OPENS_PER_DAY=20
# 当天权益少了多少美元以后不再开新仓（平仓、撤单、改止损不受影响）。留空表示不设
TRADE_DAILY_LOSS_LIMIT_USD=
# 限价单的价格，往“会立刻成交”的方向最多偏离现价百分之几
TRADE_MAX_DEVIATION_PCT=1.0
# 从预览到你确认，价格最多可以动百分之几；超过就要重新发指令
TRADE_MAX_DRIFT_PCT=0.5
# 新仓位用全仓 (cross) 还是逐仓 (isolated)。已有仓位沿用它自己的
TRADE_MARGIN_MODE=cross
# 预览发出后多少秒内确认有效
TRADE_CONFIRM_SECONDS=120
# true：开仓指令必须带止损，否则不执行
TRADE_REQUIRE_STOP=false

# ---------- 存储，一般不用改 ----------
DB_PATH=data/bot.db
LOG_DIR=logs
# 资料库文件夹：你发“记住：……”的笔记，和放进去的 .md、.txt 文档
KNOWLEDGE_DIR=knowledge

# ---------- 心跳和备份 (heartbeat and backup) ----------
# 每天把数据（仓位记录、事件、订单、成绩单、你的笔记）复制一份到 data/backups，保留多少天。填 0 表示不备份
BACKUP_KEEP_DAYS=14
# 可选：机器人每 5 分钟访问一次这个网址。配合 healthchecks.io 这类“超时没来就报警”的服务，
# 服务器整台停掉时也有人通知你。访问时不带任何账户信息。不用就留空
HEARTBEAT_URL=
