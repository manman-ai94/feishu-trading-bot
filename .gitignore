# Secrets: never commit these
.env
.env.*
!.env.example

# Local data and logs (contain account history)
data/
logs/
rollback/

# The owner's knowledge base (private notes and documents) stays on the server.
# knowledge/library/ is different: reference material written up from public sources, shipped with the code.
knowledge/*
!knowledge/README.md
!knowledge/library/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
